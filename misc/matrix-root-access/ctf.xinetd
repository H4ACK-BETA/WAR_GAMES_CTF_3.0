service ctf
{
    disable         = no
    socket_type     = stream
    protocol        = tcp
    wait            = no
    user            = ctf
    type            = UNLISTED
    port            = 9999
    bind            = 0.0.0.0
    server          = /home/ctf/chall
    per_source      = 10
    rlimit_cpu      = 30
    instances       = 50
    banner_fail     = /etc/banner_fail
}
