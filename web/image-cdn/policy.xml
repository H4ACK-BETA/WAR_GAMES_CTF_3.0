<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)+>
  <!ATTLIST policy xmlns CDATA #FIXED ''>
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy domain CDATA #REQUIRED>
  <!ATTLIST policy name CDATA #IMPLIED>
  <!ATTLIST policy pattern CDATA #IMPLIED>
  <!ATTLIST policy rights CDATA #IMPLIED>
  <!ATTLIST policy stealth CDATA #IMPLIED>
  <!ATTLIST policy value CDATA #IMPLIED>
]>
<!--
  ImageMagick security policy — INTENTIONALLY PERMISSIVE for this CTF challenge.
  In production, SVG and URL coders should be disabled!
-->
<policymap>
  <policy domain="coder" rights="read|write" pattern="*" />
  <policy domain="delegate" rights="execute" pattern="*" />
  <policy domain="filter" rights="execute" pattern="*" />
  <policy domain="path" rights="read|write" pattern="*" />
  <policy domain="resource" name="memory" value="512MiB"/>
  <policy domain="resource" name="map" value="1GiB"/>
  <policy domain="resource" name="width" value="16KP"/>
  <policy domain="resource" name="height" value="16KP"/>
  <policy domain="resource" name="area" value="128MP"/>
  <policy domain="resource" name="disk" value="1GiB"/>
</policymap>
